{:paths ["src" "resources"]
 :deps
 {;
  camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
  cheshire/cheshire {:mvn/version "6.2.0"}
  clj-commons/clj-yaml {:mvn/version "1.0.30"}
  clj-http/clj-http {:mvn/version "3.13.1"}
  com.fzakaria/slf4j-timbre {:mvn/version "0.4.1"}
  com.taoensso/timbre {:mvn/version "6.8.0"}
  crypto-random/crypto-random {:mvn/version "1.2.1"}
  digest/digest {:mvn/version "1.4.10"}
  environ/environ {:mvn/version "1.2.0"}
  honeysql/honeysql {:mvn/version "1.0.461"}
  http-kit/http-kit {:mvn/version "2.8.1"}
  inflections/inflections {:mvn/version "0.15.0"}
  logbug/logbug {:mvn/version "5.0.0"}
  nrepl/nrepl {:mvn/version "1.7.0"}
  org.clojure/core.memoize {:mvn/version "1.2.281"}
  org.clojure/data.codec {:mvn/version "0.2.1"}
  org.clojure/tools.cli {:mvn/version "1.4.256"}
  org.clojure/tools.logging {:mvn/version "1.3.1"}
  ring-middleware-accept/ring-middleware-accept {:mvn/version "2.0.3"}
  ring/ring-codec {:mvn/version "1.3.0"}
  ring/ring-core {:mvn/version "1.15.5"}
  }
 :aliases
 {;

  :build {:deps
          {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default scripts.build}


  :cljfmt {:extra-deps {io.github.weavejester/cljfmt
                        {:git/tag "0.16.5"
                         :sha "609d5706793fa494f6d76563be3318f7526f894f"}}

           :main-opts ["-m" "cljfmt.main"]}


  :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"} }
             :main-opts ["-m" "antq.core"]}

  :resource-paths ["resources"]

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  }}
